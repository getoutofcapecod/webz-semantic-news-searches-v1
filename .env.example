# Webz.io News Search API token.
#
# Copy this file to `.env.local` and fill in a real token (get one free at
# https://app.webz.io (the free tier includes monthly credits). This file is a
# template and is safe to commit; `.env.local` is gitignored and never committed.
#
#   cp .env.example .env.local
#
WEBZ_API_TOKEN=
